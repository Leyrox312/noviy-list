generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
  role     String @default("user") // admin or user
}

model Article {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  articles Article[]
}

model Race {
  id          Int    @id @default(autoincrement())
  name        String
  description String
  bonus       String
  image       String?
}

model Class {
  id          Int    @id @default(autoincrement())
  name        String
  description String
  image       String?
  levels      String // JSON string for progression table
}

model Perk {
  id          Int    @id @default(autoincrement())
  name        String
  description String
  requirement String
  image       String?
}

model Item {
  id          Int    @id @default(autoincrement())
  name        String
  type        String // Weapon, Armor, Meds, Food, Tool, Ammo
  description String
  stats       String // JSON string for specific stats
  price       Int
  image       String?
}
